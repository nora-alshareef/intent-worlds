# Copy this file to .env and fill it in. .env is in .gitignore: never commit it.
# agent.py reads .env on every run. A key set only in your shell is ignored on purpose.

# Your Anthropic API key (console.anthropic.com). Leave empty to use the Claude login of this machine.
ANTHROPIC_API_KEY=

# The model the agent runs on: an alias such as haiku, or a full model name.
INTENT_MODEL=haiku

# Only if the team uses a gateway or proxy instead of the Anthropic API. Leave empty otherwise.
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
