# Copy this file to .env and fill it in. .env is in .gitignore: never commit it.
# agent.py reads .env on every run. A key set only in your shell is ignored on purpose.

# Your Anthropic API key (console.anthropic.com). Leave empty to use the Claude login of this machine.
ANTHROPIC_API_KEY=

# The model the agent runs on: an alias such as haiku, or a full model name.
INTENT_MODEL=haiku

# Only for a gateway instead of the Anthropic API. Leave empty otherwise.
# OpenRouter (the course credit): ANTHROPIC_BASE_URL=https://openrouter.ai/api
#                                 ANTHROPIC_AUTH_TOKEN=<your OpenRouter key, starts with sk-or->
#                                 leave ANTHROPIC_API_KEY empty, and give INTENT_MODEL the OpenRouter name of the model
# Tinker (the course grant; serves open models, not Claude):
#                                 ANTHROPIC_BASE_URL=https://tinker.thinkingmachines.dev/services/tinker-prod/anthropic/api
#                                 ANTHROPIC_API_KEY=<your Tinker key>
#                                 INTENT_MODEL=<a Tinker model name, such as thinkingmachines/Inkling>
# Any other line that starts with ANTHROPIC_ or CLAUDE_CODE_ is handed to the `claude` program as it is.
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
